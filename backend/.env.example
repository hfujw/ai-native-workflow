# DeepSeek API Key（必填）
# 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择
# deepseek-chat = V3（便宜，推荐日常使用）
# deepseek-reasoner = R1（推理更强，更贵）
DEEPSEEK_MODEL=deepseek-chat

# 反向代理：docker-compose + Caddy 部署时设 true，才信任 X-Forwarded-For（防伪造）
# TRUST_PROXY=false

# 状态后端：memory（单机） | redis（多实例，需配 REDIS_URL）
# STATE_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# Tavily Search API（可选——不配也能用，LLM 会用自身知识兜底）
# 注册地址: https://tavily.com （免费 1000 次/月，国内可直连）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
