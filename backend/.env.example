# Lumen 后端配置（Key 全部在前端设置里填——后端不读 .env 的 key）

# DeepSeek API 地址（前端设置里每提供方可单独填，这里只是默认端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型（前端 Composer 选择优先于此）
DEEPSEEK_MODEL=deepseek-chat

# ── 预算护栏（可通过 env 覆盖）──
# MAX_STEPS=20
# BUDGET_TOTAL=1.0
# SEARCH_MAX=8
# LLM_STEPS=10

# ── 日志 ──
# LOG_PROMPTS=false   # 设为 true 记录完整 prompt（调试用）
# LOG_RETENTION_DAYS=30
