# Lumen 后端配置（全部可选——Key 都可以在前端设置里填，这里只作默认值/兜底）

# DeepSeek API Key（可选）
# 前端设置 → 模型 → DeepSeek → 填 Key 优先于此。
# 这里没配、前端也没填 → 生成时明确报"未配置 API Key"。
# 注册地址: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（默认即可；前端每提供方可单独填地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型（前端 Composer 选择优先于此）
DEEPSEEK_MODEL=deepseek-chat

# ── 预算护栏（可通过 env 覆盖）──
# MAX_STEPS=20
# BUDGET_TOTAL=1.0
# SEARCH_MAX=8
# LLM_STEPS=10

# ── 日志 ──
# LOG_PROMPTS=false   # 设为 true 记录完整 prompt（调试用）
# LOG_RETENTION_DAYS=30
